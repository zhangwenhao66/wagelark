---
// Interactive "where does my salary stand" tool.
//
// Why this exists: AI Overview cannibalizes clicks on pages that answer a
// single static fact (e.g. "the median is $94,260") because the AI can just
// read that number out loud. It can't run a calculation that needs the
// visitor's own input. This tool takes the visitor's stated salary and
// locates it within the *real* BLS percentile points already on this page
// (src/lib/salaryPercentile.ts does the math, pure + unit-tested) -- no
// fabricated region/experience breakdowns, see
// 工资分位数工具-实施方案_20260804.md for why that was rejected.
//
// Hourly input: the visitor can enter an hourly wage instead of an annual
// salary. It is converted to annual (x 2,080 hours, the BLS full-time
// convention) for the percentile lookup, since bls-wages.ts publishes
// percentiles only as annual figures. Where BLS published a real
// medianHourly for the occupation, that figure is shown as the hourly
// reference rather than a division of the annual median.
//
// Framework note: this site is pure static Astro with no Preact/React/Vue.
// This stays that way -- the interactivity here is a single vanilla
// `<script type="module">` island that imports the pure calculation
// function directly, same "logic function + thin UI wrapper" split as the
// CalcBadger tool site, just without a component framework underneath it.
import type { BlsWageEntry } from '../data/bls-wages';
import { annualToHourly, BLS_FULL_TIME_HOURS_PER_YEAR } from '../lib/salaryPercentile';

interface Props {
	wage: BlsWageEntry;
}

const { wage } = Astro.props;

// Only the fields the client script actually needs, serialized into the
// page at build time (not fetched at runtime -- this is static data BLS
// already published, not a live API).
const toolData = {
	title: wage.title,
	medianAnnual: wage.medianAnnual,
	medianHourly: wage.medianHourly ?? null,
	percentiles: wage.percentiles,
	industryWages: wage.industryWages,
	dataYear: wage.dataYear,
	sourceLabel: wage.sourceLabel,
	sourceUrl: wage.sourceUrl,
};

const hasPercentileBreakdown = wage.percentiles.p10 !== undefined || wage.percentiles.p25 !== undefined || wage.percentiles.p75 !== undefined || wage.percentiles.p90 !== undefined;

// Placeholder for the hourly field: the real BLS hourly median when it
// exists, otherwise the 2,080-hour conversion of the annual median.
const hourlyPlaceholder = (wage.medianHourly ?? annualToHourly(wage.medianAnnual)).toFixed(2);
const hoursPerYearLabel = BLS_FULL_TIME_HOURS_PER_YEAR.toLocaleString('en-US');
const usdCents = (n: number) => `$${n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
---

<div class="salary-percentile-tool mt-9 border border-[var(--rule)] bg-white p-5" data-tool={JSON.stringify(toolData)}>
	<p class="m-0 text-[0.7rem] font-semibold uppercase tracking-[0.1em] text-[var(--teal-dark)]">Tool</p>
	<h2 class="mt-2 mb-0 text-xl font-bold text-[var(--navy)]">See where your salary stands</h2>
	<p class="mt-2 mb-0 text-sm leading-relaxed text-[var(--ink)]/65">
		Enter your own pay as a {wage.title.toLowerCase()}, either annual or hourly, and this tool locates it against the BLS wage percentiles above{hasPercentileBreakdown ? '' : ' (this occupation only has a published median, not a fuller percentile breakdown, as noted below)'}.
	</p>

	<form id="percentile-form" class="mt-4 flex flex-wrap items-end gap-3">
		<fieldset class="m-0 flex flex-col gap-1.5 border-0 p-0">
			<legend class="mb-1.5 p-0 text-xs font-semibold text-[var(--ink)]/70">Pay basis</legend>
			<div class="flex border border-[var(--rule)]" role="radiogroup" aria-label="Pay basis">
				<label class="cursor-pointer select-none px-3 py-2 text-[0.7rem] font-semibold uppercase tracking-[0.08em] text-[var(--ink-soft)] transition-colors has-checked:bg-[var(--navy)] has-checked:text-[var(--paper)] has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-[var(--teal)]">
					<input type="radio" name="pay-basis" value="annual" class="sr-only" checked />
					Annual
				</label>
				<label class="cursor-pointer select-none border-l border-[var(--rule)] px-3 py-2 text-[0.7rem] font-semibold uppercase tracking-[0.08em] text-[var(--ink-soft)] transition-colors has-checked:bg-[var(--navy)] has-checked:text-[var(--paper)] has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-[var(--teal)]">
					<input type="radio" name="pay-basis" value="hourly" class="sr-only" />
					Hourly
				</label>
			</div>
		</fieldset>
		<div class="flex flex-col gap-1.5">
			<label id="percentile-salary-label" for="percentile-salary-input" class="text-xs font-semibold text-[var(--ink)]/70">Your annual salary (USD)</label>
			<div class="flex items-center gap-1.5 border border-[var(--rule)] bg-[var(--paper)] px-3 py-2">
				<span class="font-mono-figures text-sm text-[var(--ink)]/50" aria-hidden="true">$</span>
				<input
					id="percentile-salary-input"
					name="salary"
					type="number"
					inputmode="numeric"
					min="0"
					step="1"
					placeholder={wage.medianAnnual.toString()}
					data-annual-placeholder={wage.medianAnnual.toString()}
					data-hourly-placeholder={hourlyPlaceholder}
					required
					class="font-mono-figures w-36 bg-transparent text-sm text-[var(--ink)] outline-none"
				/>
				<span id="percentile-salary-unit" class="font-mono-figures text-[0.7rem] uppercase tracking-[0.06em] text-[var(--ink)]/50" aria-hidden="true">/yr</span>
			</div>
		</div>
		<button
			type="submit"
			class="border border-[var(--navy)] bg-[var(--navy)] px-4 py-2 text-sm font-semibold text-[var(--paper)] transition-colors hover:bg-[var(--navy-deep)]"
		>
			See my percentile
		</button>
	</form>

	<div id="percentile-result" class="mt-5" hidden aria-live="polite">
		<div class="border-l-2 border-[var(--teal)] bg-[var(--panel)] py-3 pl-4">
			<p id="percentile-result-equivalent" class="font-mono-figures m-0 text-sm font-semibold text-[var(--navy)]"></p>
			<p id="percentile-result-text" class="mt-1.5 mb-0 text-[0.95rem] leading-relaxed text-[var(--ink)]"></p>
		</div>
		<div id="percentile-industry-compare" class="mt-3" hidden>
			<p class="m-0 text-xs font-semibold uppercase tracking-[0.08em] text-[var(--ink)]/45">If you moved industries</p>
			<p class="mt-1.5 mb-0 text-xs leading-relaxed text-[var(--ink)]/55">
				These are published industry medians for {wage.title.toLowerCase()}, not a personalized prediction for your salary.
			</p>
			<div id="percentile-industry-list" class="mt-2 flex flex-col"></div>
		</div>
	</div>

	<p class="mt-4 mb-0 text-xs text-[var(--ink)]/45">
		{wage.medianHourly !== undefined
			? <>BLS publishes a median hourly wage of <span class="font-mono-figures font-semibold text-[var(--ink-soft)]">{usdCents(wage.medianHourly)}</span> for this occupation; that real figure is used as the hourly reference. Your own hourly-to-annual conversion assumes {hoursPerYearLabel} hours/year (BLS full-time convention).</>
			: <>BLS does not publish a separate hourly median for this occupation, so hourly figures here are the annual figure divided by {hoursPerYearLabel} hours/year (BLS full-time convention).</>}
	</p>
	<p class="mt-2 mb-0 text-xs text-[var(--ink)]/45">
		Calculated client-side from <a href={wage.sourceUrl} target="_blank" rel="noopener noreferrer" class="text-[var(--teal-dark)] no-underline hover:underline">{wage.sourceLabel}</a>, {wage.dataYear}. Not personalized career, financial, or tax advice.
	</p>
</div>

<script>
	import {
		estimatePercentile,
		normalizeWageInput,
		describeWagePair,
		annualToHourly,
		BLS_FULL_TIME_HOURS_PER_YEAR,
		type PercentileSource,
		type WageInputMode,
	} from '../lib/salaryPercentile';
	import type { IndustryWage } from '../data/bls-wages';

	interface ToolData extends PercentileSource {
		title: string;
		medianHourly: number | null;
		industryWages: IndustryWage[];
		dataYear: string;
		sourceLabel: string;
		sourceUrl: string;
	}

	const usd = (n: number) => `$${Math.round(n).toLocaleString('en-US')}`;
	const usdCents = (n: number) => `$${n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

	const MODE_UI: Record<WageInputMode, { label: string; step: string; inputmode: string; unit: string }> = {
		annual: { label: 'Your annual salary (USD)', step: '1', inputmode: 'numeric', unit: '/yr' },
		hourly: { label: 'Your hourly wage (USD)', step: '0.01', inputmode: 'decimal', unit: '/hr' },
	};

	document.querySelectorAll<HTMLElement>('.salary-percentile-tool').forEach((root) => {
		const raw = root.dataset.tool;
		if (!raw) return;
		const toolData: ToolData = JSON.parse(raw);

		const form = root.querySelector<HTMLFormElement>('#percentile-form');
		const input = root.querySelector<HTMLInputElement>('#percentile-salary-input');
		const inputLabel = root.querySelector<HTMLElement>('#percentile-salary-label');
		const inputUnit = root.querySelector<HTMLElement>('#percentile-salary-unit');
		const modeRadios = Array.from(root.querySelectorAll<HTMLInputElement>('input[name="pay-basis"]'));
		const resultBox = root.querySelector<HTMLElement>('#percentile-result');
		const resultText = root.querySelector<HTMLElement>('#percentile-result-text');
		const resultEquivalent = root.querySelector<HTMLElement>('#percentile-result-equivalent');
		const industryCompare = root.querySelector<HTMLElement>('#percentile-industry-compare');
		const industryList = root.querySelector<HTMLElement>('#percentile-industry-list');
		if (!form || !input || !resultBox || !resultText) return;

		const currentMode = (): WageInputMode => (modeRadios.find((r) => r.checked)?.value === 'hourly' ? 'hourly' : 'annual');

		const applyMode = (mode: WageInputMode) => {
			const ui = MODE_UI[mode];
			input.step = ui.step;
			input.setAttribute('inputmode', ui.inputmode);
			input.placeholder = (mode === 'hourly' ? input.dataset.hourlyPlaceholder : input.dataset.annualPlaceholder) ?? '';
			if (inputLabel) inputLabel.textContent = ui.label;
			if (inputUnit) inputUnit.textContent = ui.unit;
			// A value typed in one basis is meaningless in the other; clear it and
			// hide any stale result rather than silently reinterpreting it.
			input.value = '';
			resultBox.hidden = true;
		};

		modeRadios.forEach((radio) => radio.addEventListener('change', () => applyMode(currentMode())));
		// Browsers can restore a previously checked radio on back/forward
		// navigation, so sync the field to whatever is actually selected.
		applyMode(currentMode());

		form.addEventListener('submit', (event) => {
			event.preventDefault();
			const pair = normalizeWageInput(Number(input.value), currentMode());
			if (!pair) return;

			const estimate = estimatePercentile(pair.annual, toolData);

			if (resultEquivalent) {
				// Reference hourly figure: the real BLS-published median hourly wage
				// when the occupation has one, otherwise the annual median divided
				// by the 2,080-hour convention (labelled as such).
				const reference =
					toolData.medianHourly !== null
						? `BLS median: ${usdCents(toolData.medianHourly)}/hour (published) · ${usd(toolData.medianAnnual)}/year`
						: `BLS median: ${usd(toolData.medianAnnual)}/year ≈ ${usdCents(annualToHourly(toolData.medianAnnual))}/hour at ${BLS_FULL_TIME_HOURS_PER_YEAR.toLocaleString('en-US')} hrs/yr`;
				resultEquivalent.textContent = `${describeWagePair(pair)} — ${reference}`;
			}
			resultText.textContent = estimate.message;
			resultBox.hidden = false;

			if (industryCompare && industryList) {
				if (toolData.industryWages.length > 0) {
					industryList.innerHTML = '';
					for (const iw of toolData.industryWages) {
						const row = document.createElement('div');
						row.className = 'flex items-center justify-between border-b border-[var(--rule)] py-1.5 text-xs last:border-b-0';
						const label = document.createElement('span');
						label.className = 'text-[var(--ink)]/70';
						label.textContent = iw.industry;
						const wageEl = document.createElement('span');
						wageEl.className = 'font-mono-figures font-semibold text-[var(--navy)]';
						wageEl.textContent = usd(iw.annualWage);
						row.append(label, wageEl);
						industryList.append(row);
					}
					industryCompare.hidden = false;
				} else {
					industryCompare.hidden = true;
				}
			}
		});
	});
</script>
