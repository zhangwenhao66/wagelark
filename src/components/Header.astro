---
import { SITE_TITLE } from '../consts';
const seriesYear = new Date().getFullYear();
---

<header class="border-b border-[var(--rule)] bg-[var(--paper)]">
	<div class="border-b border-[var(--rule)]">
		<div class="font-mono-figures mx-auto flex max-w-4xl items-center justify-between gap-3 px-4 py-1.5 text-[0.62rem] tracking-[0.14em] uppercase text-[var(--ink-soft)]">
			<span class="truncate">U.S. salary &amp; occupation data · BLS sourced</span>
			<span class="shrink-0">Ser. {seriesYear}</span>
		</div>
	</div>
	<nav class="mx-auto flex h-16 max-w-4xl items-center justify-between gap-2 px-4">
		<a href="/" class="flex shrink-0 items-center gap-2 no-underline" aria-label={`${SITE_TITLE} home`}>
			<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<rect x="3" y="14" width="4" height="7" rx="0.75" fill="var(--teal)" opacity="0.55"/>
				<rect x="10" y="9" width="4" height="12" rx="0.75" fill="var(--teal)" opacity="0.8"/>
				<rect x="17" y="3" width="4" height="18" rx="0.75" fill="var(--teal)"/>
			</svg>
			<span class="text-[1.3rem] font-extrabold tracking-tight text-[var(--navy)]">{SITE_TITLE}</span>
		</a>

		<div class="hidden items-center gap-7 md:flex">
			<a href="/salary-guides/" class="nav-link text-[0.9rem] font-medium text-[var(--ink)]/75 no-underline">Salary Guides</a>
			<a href="/career-guides/" class="nav-link text-[0.9rem] font-medium text-[var(--ink)]/75 no-underline">Career Guides</a>
			<a href="/how-to-become/" class="nav-link text-[0.9rem] font-medium text-[var(--ink)]/75 no-underline">How to Become</a>
			<a href="/about/" class="nav-link text-[0.9rem] font-medium text-[var(--ink)]/75 no-underline">About</a>
		</div>

		<button
			id="menu-toggle"
			class="flex h-9 w-9 flex-col items-center justify-center gap-1.5 md:hidden"
			aria-label="Open menu"
			aria-expanded="false"
			aria-controls="mobile-menu"
		>
			<span class="h-px w-5 bg-[var(--ink)]"></span>
			<span class="h-px w-5 bg-[var(--ink)]"></span>
			<span class="h-px w-5 bg-[var(--ink)]"></span>
		</button>
	</nav>

	<div id="mobile-menu" class="hidden border-t border-[var(--rule)] bg-[var(--paper)] md:hidden">
		<nav class="flex flex-col px-4 py-2">
			<a href="/salary-guides/" class="border-b border-[var(--rule)] py-3 text-sm text-[var(--ink)]/80 no-underline">Salary Guides</a>
			<a href="/career-guides/" class="border-b border-[var(--rule)] py-3 text-sm text-[var(--ink)]/80 no-underline">Career Guides</a>
			<a href="/how-to-become/" class="border-b border-[var(--rule)] py-3 text-sm text-[var(--ink)]/80 no-underline">How to Become</a>
			<a href="/about/" class="py-3 text-sm text-[var(--ink)]/80 no-underline">About</a>
		</nav>
	</div>
</header>

<script>
	const toggle = document.getElementById('menu-toggle')!;
	const menu = document.getElementById('mobile-menu')!;
	toggle.addEventListener('click', () => {
		const open = menu.classList.toggle('hidden');
		toggle.setAttribute('aria-expanded', String(!open));
	});
</script>

<style>
	.nav-link {
		position: relative;
	}
	.nav-link::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -3px;
		height: 2px;
		background: var(--teal);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.18s ease;
	}
	.nav-link:hover {
		color: var(--ink);
	}
	.nav-link:hover::after {
		transform: scaleX(1);
	}
</style>
