---
// 2026-09-13 缺口簇立项，来源 对标站sitemap盘点_20260913.md（对标 careerexplorer.com 的 /archetypes 簇）。
// 仅为已准备的骨架页：当日发布配额已被 speech-language-pathologist-salary 占用（见 内容发布日志.md），
// 本次只提交到本地分支 gap-cluster-career-quiz-20260913、不 push 到 origin/main，
// 因此不会被 Cloudflare Pages 构建上线——安全边界靠"不推送"，不是靠 noindex（本页未加 noindex 标签）。
// 上线前仍需：常规发布任务把它排进当日配额、跑齐 humanizer/avoid-ai-writing/google-spam-compliance/
// title_lint 全套质检、独立复核，并把 GuideCategory 是否要新增 'Career Quiz' 分类的问题交给正式发布任务决定。
//
// 2026-09-13 15词穷举补测追加：除 career quiz for teens 外，又在 free career test with free
// results（880/月）里找到第二个 A 档证据——careerkit.me（whois 注册 15.5 个月，真实 RIASEC 测验产品，
// 免注册即时出结果）。三个独立年轻竞品（my-career-path.com/mypassion.ai/careerkit.me）共同的卖点是
// "零注册墙、客户端即时算分"，本页下方的 vanilla JS 计分逻辑天然满足这一点，无需为此改代码。
// 详见 独立站/缺口簇立项_20260913.md WageLark 节「2026-09-13 补测」。
import Layout from '../../layouts/Layout.astro';

const archetypes = [
	{
		id: 'healer',
		name: 'Hands-On Healer',
		blurb: 'You want to see the direct result of your work on one person, in real time.',
		guides: [
			{ slug: 'dental-hygienist-salary', label: 'Dental Hygienist' },
			{ slug: 'physical-therapist-salary', label: 'Physical Therapist' },
			{ slug: 'respiratory-therapist-salary', label: 'Respiratory Therapist' },
		],
	},
	{
		id: 'builder',
		name: 'Skilled Builder',
		blurb: 'You think in systems you can touch: wiring, airflow, load-bearing walls.',
		guides: [
			{ slug: 'electrician-salary', label: 'Electrician' },
			{ slug: 'hvac-certification', label: 'HVAC Technician' },
			{ slug: 'welder-salary', label: 'Welder' },
		],
	},
	{
		id: 'analyst',
		name: 'Precision Analyst',
		blurb: 'You would rather be right than be fast, and you like instruments that prove it.',
		guides: [
			{ slug: 'clinical-laboratory-technologist-salary', label: 'Clinical Laboratory Technologist' },
			{ slug: 'radiology-tech-salary', label: 'Radiology Technologist' },
			{ slug: 'actuary-salary', label: 'Actuary' },
		],
	},
	{
		id: 'responder',
		name: 'Frontline Responder',
		blurb: "Unpredictable days don't drain you. They're the reason you took the job.",
		guides: [
			{ slug: 'firefighter-salary', label: 'Firefighter' },
			{ slug: 'how-to-become-a-paramedic', label: 'Paramedic' },
			{ slug: 'air-traffic-controller-salary', label: 'Air Traffic Controller' },
		],
	},
	{
		id: 'support',
		name: 'Steady Support',
		blurb: 'You keep the record straight and the process moving, without needing the spotlight.',
		guides: [
			{ slug: 'how-to-become-a-paralegal', label: 'Paralegal' },
			{ slug: 'medical-assistant-salary', label: 'Medical Assistant' },
			{ slug: 'what-does-a-bookkeeper-do', label: 'Bookkeeper' },
		],
	},
];

const questions = [
	{
		q: 'A machine at work starts making a noise nobody can explain. Your instinct is to…',
		opts: [
			{ t: 'Open it up and trace the fault yourself', a: 'builder' },
			{ t: 'Run the diagnostic checklist, step by step', a: 'analyst' },
			{ t: 'Flag it and keep the process moving around it', a: 'support' },
			{ t: 'Check that nobody nearby is in danger first', a: 'responder' },
		],
	},
	{
		q: 'Pick the part of a project you actually look forward to.',
		opts: [
			{ t: 'The moment a person visibly feels better because of what you did', a: 'healer' },
			{ t: 'Getting the numbers to finally reconcile', a: 'analyst' },
			{ t: 'Building the thing with your hands, start to finish', a: 'builder' },
			{ t: 'Making sure nothing falls through the cracks', a: 'support' },
		],
	},
	{
		q: 'Your ideal Tuesday has…',
		opts: [
			{ t: "Every hour looks different, and you go where you're needed", a: 'responder' },
			{ t: "A predictable rhythm you've gotten good at", a: 'support' },
			{ t: 'One-on-one time with the same few people all day', a: 'healer' },
			{ t: 'A physical task with a visible result by 5pm', a: 'builder' },
		],
	},
	{
		q: 'Which mistake would bother you more?',
		opts: [
			{ t: "A measurement that's off by a fraction", a: 'analyst' },
			{ t: 'A missed deadline that throws off everyone else', a: 'support' },
			{ t: 'Reacting a beat too slow in an emergency', a: 'responder' },
			{ t: "A repair that looks fine but isn't", a: 'builder' },
		],
	},
	{
		q: "Someone asks what you're good at. You say:",
		opts: [
			{ t: "People trust me with them when they're not okay", a: 'healer' },
			{ t: "I stay calm when everyone else doesn't", a: 'responder' },
			{ t: 'I notice the detail everyone else missed', a: 'analyst' },
			{ t: "Give me the manual and I'll figure out the rest", a: 'builder' },
		],
	},
	{
		q: 'What would make you quit a job fastest?',
		opts: [
			{ t: 'Never getting to finish anything with your own hands', a: 'builder' },
			{ t: 'Feeling invisible even when the work matters', a: 'support' },
			{ t: 'Sloppy processes nobody bothers to fix', a: 'analyst' },
			{ t: "Being kept away from the people you're meant to help", a: 'healer' },
		],
	},
]

const idToArchetype = Object.fromEntries(archetypes.map((a) => [a.id, a]))
---

<Layout
	title="Career Personality Quiz"
	description="A six-question quiz that matches your work style to real career paths in WageLark's salary guides, grounded in BLS wage data instead of a generic personality label."
>
	<div class="rule-double pt-4">
		<p class="font-mono-figures m-0 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 text-[0.68rem] tracking-[0.14em] uppercase text-[var(--ink-soft)]">
			<span class="text-[var(--teal-dark)] font-semibold">Quiz</span>
			<span>6 questions &middot; 2 minutes</span>
		</p>
		<h1 class="mt-3 mb-0 text-3xl font-bold text-[var(--navy)] md:text-4xl">Which Career Path Actually Fits You?</h1>
		<p class="mt-3 mb-0 max-w-2xl border-b border-[var(--rule)] pb-4 text-lg text-[var(--ink-soft)]">
			Most career quizzes end with a personality label. This one ends with three real jobs, each linked to
			WageLark's own BLS-sourced salary guide instead of a generic description.
		</p>
	</div>

	<div id="quiz-root" class="mt-8 max-w-2xl">
		<div id="quiz-questions"></div>
		<div id="quiz-result" hidden></div>
	</div>

	<section class="mt-14 max-w-2xl">
		<h2 class="text-xl font-bold text-[var(--navy)]">FAQ</h2>
		<div class="mt-4 flex flex-col gap-6">
			<div>
				<p class="m-0 font-semibold text-[var(--navy)]">What are some good career tests for teenagers?</p>
				<p class="m-0 mt-1 text-[var(--ink-soft)]">One built around concrete work styles rather than abstract personality types tends to hold up better for teens who don't yet have a job to compare the questions against. This quiz uses situational questions, like what you'd do when a machine breaks or what mistake would bother you most, instead of asking teens to rate themselves on traits they haven't tested yet.</p>
			</div>
			<div>
				<p class="m-0 font-semibold text-[var(--navy)]">What are some good career assessments for high schoolers?</p>
				<p class="m-0 mt-1 text-[var(--ink-soft)]">The most useful ones connect a result to an actual entry path (required schooling, typical age to start earning, real pay data) rather than stopping at a label like "Investigator" or "Builder." Every result on this page links to a full WageLark guide with that detail sourced from the U.S. Bureau of Labor Statistics.</p>
			</div>
			<div>
				<p class="m-0 font-semibold text-[var(--navy)]">How is this different from a "what career suits my personality" quiz?</p>
				<p class="m-0 mt-1 text-[var(--ink-soft)]">Generic personality-career quizzes match you to a broad category, like creative, analytical, or social, that covers thousands of unrelated jobs. This one is scoped to the professions WageLark has actually researched in depth: mostly healthcare, skilled trades, and safety-critical roles. Every result points to a page with real median pay, education requirements, and job outlook instead of a one-line description.</p>
			</div>
		</div>
	</section>

	<script type="application/json" id="archetype-data" set:html={JSON.stringify(archetypes)} />
	<script type="application/json" id="question-data" set:html={JSON.stringify(questions)} />

	<script>
		const archetypes = JSON.parse(document.getElementById('archetype-data')!.textContent!);
		const questions = JSON.parse(document.getElementById('question-data')!.textContent!);
		const qRoot = document.getElementById('quiz-questions')!;
		const resultRoot = document.getElementById('quiz-result')!;
		const tally: Record<string, number> = {};

		function renderQuestion(i: number) {
			if (i >= questions.length) return renderResult();
			const q = questions[i];
			qRoot.innerHTML = `
				<p class="font-mono-figures m-0 text-[0.68rem] tracking-[0.14em] uppercase text-[var(--ink-mute)]">Question ${i + 1} of ${questions.length}</p>
				<h2 class="mt-2 mb-4 text-xl font-bold text-[var(--navy)]">${q.q}</h2>
				<div class="flex flex-col gap-2">
					${q.opts.map((o: any, idx: number) => `<button data-a="${o.a}" class="opt-btn text-left rounded-md border border-[var(--rule)] px-4 py-3 text-[var(--ink)] hover:border-[var(--teal-dark)] hover:bg-[var(--panel)]" style="background:var(--paper);">${o.t}</button>`).join('')}
				</div>
			`;
			qRoot.querySelectorAll('.opt-btn').forEach((btn) => {
				btn.addEventListener('click', () => {
					const a = (btn as HTMLElement).dataset.a!;
					tally[a] = (tally[a] || 0) + 1;
					renderQuestion(i + 1);
				});
			});
		}

		function renderResult() {
			qRoot.innerHTML = '';
			resultRoot.hidden = false;
			const winner = Object.entries(tally).sort((a, b) => b[1] - a[1])[0]?.[0] || archetypes[0].id;
			const match = archetypes.find((a: any) => a.id === winner) || archetypes[0];
			resultRoot.innerHTML = `
				<p class="font-mono-figures m-0 text-[0.68rem] tracking-[0.14em] uppercase text-[var(--teal-dark)]">Your result</p>
				<h2 class="mt-2 mb-2 text-2xl font-bold text-[var(--navy)]">${match.name}</h2>
				<p class="m-0 mb-5 text-[var(--ink-soft)]">${match.blurb}</p>
				<p class="font-mono-figures m-0 mb-2 text-[0.68rem] tracking-[0.14em] uppercase text-[var(--ink-mute)]">Real jobs that fit this style</p>
				<div class="flex flex-col gap-2">
					${match.guides.map((g: any) => `<a href="/${g.slug}/" class="rounded-md border border-[var(--rule)] px-4 py-3 no-underline text-[var(--navy)] font-semibold hover:border-[var(--teal-dark)]" style="background:var(--paper);">${g.label} salary guide &rarr;</a>`).join('')}
				</div>
				<button id="retake" class="mt-6 text-sm text-[var(--teal-dark)] underline bg-transparent border-0 cursor-pointer p-0">Retake the quiz</button>
			`;
			document.getElementById('retake')?.addEventListener('click', () => {
				for (const k in tally) delete tally[k];
				resultRoot.hidden = true;
				renderQuestion(0);
			});
		}

		renderQuestion(0);
	</script>
</Layout>
