---
import Layout from '../../layouts/Layout.astro';
import { guides } from '../../data/guides';

const categoryGuides = guides.filter((g) => g.category === 'Career Guide');
---

<Layout
	title="Career Guides"
	description="What the job actually involves day to day: duties, specialties, and where the pay comes from, based on BLS occupational data."
>
	<p class="m-0 text-[0.7rem] font-semibold uppercase tracking-[0.12em] text-[var(--teal-dark)]">Section</p>
	<h1 class="mt-2 text-3xl font-bold text-[var(--navy)] md:text-4xl">Career Guides</h1>
	<p class="mt-3 max-w-2xl text-lg text-[var(--ink)]/60">
		What people in this role do all day, the specialties within it, and how the work maps to pay.
	</p>

	{categoryGuides.length === 0 ? (
		<p class="mt-10 text-sm text-[var(--ink)]/40">Guides in this section are coming soon.</p>
	) : (
		<div class="mt-10 flex flex-col">
			{categoryGuides.map((g) => (
				<a href={`/${g.slug}/`} class="item border-b border-[var(--rule)] py-5 no-underline first:pt-0">
					<p class="m-0 text-lg font-bold leading-snug text-[var(--navy)] hover:underline">{g.title}</p>
					<p class="m-0 mt-1.5 text-sm text-[var(--ink)]/55">{g.description}</p>
				</a>
			))}
		</div>
	)}
</Layout>

<style>
	.item { display: block; transition: padding-left 0.15s ease; }
	.item:hover { padding-left: 0.5rem; }
</style>
