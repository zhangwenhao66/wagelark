---
import { SITE_TITLE } from '../consts';
const year = new Date().getFullYear();
---

<footer class="bg-[var(--navy-deep)]">
	<div class="mx-auto max-w-5xl px-4 py-9 text-sm text-white/70">
		<p class="m-0 max-w-2xl text-[0.8rem] leading-relaxed text-white/50">
			Wage and employment figures on {SITE_TITLE} come from the U.S. Bureau of Labor Statistics (BLS)
			Occupational Employment and Wage Statistics program and Occupational Outlook Handbook, both public
			domain U.S. government data. Every figure is labeled with its data year and links to the source page.
			{SITE_TITLE} is not affiliated with the BLS and does not provide personalized career, financial, or
			legal advice.
		</p>
		<div class="mt-6 flex flex-col gap-4 border-t border-white/10 pt-6 md:flex-row md:items-center md:justify-between">
			<p class="m-0 text-[0.95rem] text-white">&copy; {year} {SITE_TITLE}</p>
			<nav class="flex flex-wrap gap-5">
				<a href="/salary-guides/" class="text-white/70 no-underline hover:text-white hover:underline">Salary Guides</a>
				<a href="/career-guides/" class="text-white/70 no-underline hover:text-white hover:underline">Career Guides</a>
				<a href="/how-to-become/" class="text-white/70 no-underline hover:text-white hover:underline">How to Become</a>
				<a href="/about/" class="text-white/70 no-underline hover:text-white hover:underline">About</a>
				<a href="/privacy/" class="text-white/70 no-underline hover:text-white hover:underline">Privacy</a>
				<a href="/terms/" class="text-white/70 no-underline hover:text-white hover:underline">Terms</a>
			</nav>
		</div>
	</div>
</footer>
