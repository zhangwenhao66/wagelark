---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Page Not Found"
	description="This page doesn't exist on WageLark. Head back to the homepage to find what you were after."
>
	<meta slot="head" name="robots" content="noindex, follow" />

	<div class="mx-auto max-w-[720px]">
		<p class="mb-3 text-[0.7rem] font-semibold uppercase tracking-[0.25em] text-[var(--teal-dark)]">
			404
		</p>
		<h1 class="text-3xl font-bold text-[var(--navy)] md:text-4xl">Page not found</h1>

		<div class="mt-7 max-w-[640px] text-[0.9375rem] leading-[1.85] text-[var(--ink)]/70">
			<p class="mb-4">
				There's nothing at this address. The link may be mistyped, or it may point to a page that
				was never published here.
			</p>
			<p class="m-0">
				Try the <a class="text-[var(--teal-dark)] underline underline-offset-2" href="/">homepage</a
				>, or go straight to <a
					class="text-[var(--teal-dark)] underline underline-offset-2"
					href="/salary-guides/">salary guides</a
				>, <a class="text-[var(--teal-dark)] underline underline-offset-2" href="/career-guides/"
					>career guides</a
				>, or <a class="text-[var(--teal-dark)] underline underline-offset-2" href="/how-to-become/">how to become</a
				> guides.
			</p>
		</div>
	</div>
</Layout>
