---
import Layout from '../layouts/Layout.astro';
import { guides, wageDataFor, type GuideCategory } from '../data/guides';

const sorted = [...guides].sort((a, b) => b.updated.localeCompare(a.updated));
const latest = sorted[0];

const PILLARS: { category: GuideCategory; path: string; deck: string }[] = [
	{
		category: 'Salary Guide',
		path: '/salary-guides/',
		deck: 'What the job actually pays, by percentile, straight from BLS wage surveys.',
	},
	{
		category: 'Career Guide',
		path: '/career-guides/',
		deck: 'What the work involves day to day, and where the pay comes from.',
	},
	{
		category: 'How to Become',
		path: '/how-to-become/',
		deck: 'The real education and certification path, not the shortcut version.',
	},
];

const byPillar = PILLARS.map((p) => ({
	...p,
	items: sorted.filter((g) => g.category === p.category).slice(0, 3),
}));
---

<Layout>
	<section class="pt-4 pb-14 md:pt-8">
		<h1 class="max-w-3xl text-4xl leading-[1.12] font-bold tracking-tight text-[var(--navy)] md:text-5xl">
			What jobs actually pay, sourced from the U.S. government.
		</h1>
		<p class="mt-5 max-w-xl text-[1.02rem] leading-relaxed text-[var(--ink)]/60">
			Every wage figure on this site comes from BLS occupational wage surveys, not self-reported
			salary sites — labeled with its data year and linked back to the source.
		</p>
		{latest && (
			<a href={`/${latest.slug}/`} class="latest mt-8 inline-block max-w-xl border-l-2 border-[var(--teal)] pl-4 no-underline">
				<p class="m-0 text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-[var(--teal-dark)]">Latest</p>
				<p class="latest-title m-0 mt-1 text-[1.2rem] leading-snug font-bold text-[var(--navy)]">{latest.title}</p>
			</a>
		)}
	</section>

	{byPillar.map((p) => (
		<section class="mb-14 last:mb-0">
			<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-[var(--rule)] pb-3">
				<h2 class="m-0 text-[1.5rem] font-bold tracking-tight text-[var(--navy)]">{p.category === 'Salary Guide' ? 'Salary Guides' : p.category === 'Career Guide' ? 'Career Guides' : 'How to Become'}</h2>
				<a href={p.path} class="text-sm font-medium text-[var(--teal-dark)] no-underline hover:underline">
					See all
				</a>
			</div>
			<p class="mt-2 mb-0 max-w-xl text-[0.95rem] leading-relaxed text-[var(--ink)]/60">{p.deck}</p>

			{p.items.length > 0 ? (
				<div class="mt-6 grid gap-x-8 gap-y-6 sm:grid-cols-3">
					{p.items.map((g) => {
						const wage = wageDataFor(g);
						return (
							<a href={`/${g.slug}/`} class="entry block border border-[var(--rule)] bg-white p-4 no-underline">
								{wage && (
									<p class="font-mono-figures m-0 text-lg font-bold text-[var(--teal-dark)]">${wage.medianAnnual.toLocaleString('en-US')}<span class="text-xs font-normal text-[var(--ink)]/40">/yr median</span></p>
								)}
								<p class="entry-title m-0 mt-1.5 text-[1.0rem] leading-snug font-bold text-[var(--navy)]">{g.title}</p>
								<p class="m-0 mt-1.5 text-sm leading-relaxed text-[var(--ink)]/60">{g.description}</p>
							</a>
						);
					})}
				</div>
			) : (
				<p class="mt-6 mb-0 text-sm text-[var(--ink)]/45">
					Nothing published here yet. <a href={p.path} class="text-[var(--teal-dark)] underline underline-offset-2">See what this section covers</a>.
				</p>
			)}
		</section>
	))}
</Layout>

<style>
	.latest:hover .latest-title,
	.entry:hover .entry-title {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
</style>
